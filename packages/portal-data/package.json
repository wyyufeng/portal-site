    "axios": "^0.19.0",
    "crypto-js": "^3.1.9-1",
    "csstype": "^2.6.10",
    "html-to-text": "^5.1.1",
    "portal-types": "^1.0.1",
    "redux-saga": "^1.1.3"
  },
  "peerDependencies": {
    "typescript": "^3.8.3"
  },
  "devDependencies": {
    "rimraf": "^3.0.1"
  },
