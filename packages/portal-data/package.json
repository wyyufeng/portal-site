  "homepage": "https://github.com/wyyufeng/portal-site#readme",
  "license": "MIT",
  "main": "lib/index.js",
  "module": "esm/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "files": [
    "*.md",
    "lib",
    "esm",
    "src"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyyufeng/portal-site.git"
  },
  "scripts": {
    "build": "yarn run build-cjs && yarn run build-esm",
    "build-cjs": "rimraf ./lib && tsc",
    "build-esm": "rimraf ./esm && tsc --outDir esm --module es2015",
    "watch": "tsc --watch"
  },
  "bugs": {
