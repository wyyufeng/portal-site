{
    "exclude": ["node_modules"],
    "compilerOptions": {
        "target": "ES5",
        "module": "ES2015",
        "lib": ["ES2016.Array.Include", "es2015", "DOM", "ES2018.Promise"],
        "allowJs": true,
        "jsx": "react",
        "noImplicitAny": false,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["@emotion/core"]
    }
}
